# =========================
# BCCR API Configuration
# =========================

BCCR_BASE_URL=https://gee.bccr.fi.cr
BCCR_EMAIL=your_email@example.com
BCCR_TOKEN=your_bccr_token_here


# =========================
# Local Data Paths
# =========================

RAW_DATA_PATH=./data/bronze
SILVER_DATA_PATH=./data/silver
GOLD_DATA_PATH=./data/gold


# =========================
# Databricks Configuration
# =========================

DATABRICKS_HOST=https://your-databricks-workspace-url
DATABRICKS_TOKEN=your_databricks_token_here
DATABRICKS_CLUSTER_ID=your_cluster_id_here


# =========================
# Pipeline Configuration
# =========================

PIPELINE_ENV=dev
PIPELINE_TIMEZONE=America/Costa_Rica